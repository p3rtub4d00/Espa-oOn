{
  "name": "EspaçoOn Admin",
  "short_name": "EspaçoOn Admin",
  "description": "Painel administrativo do EspaçoOn",
  "start_url": "/admin",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f3554",
  "theme_color": "#0f3554",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "id": "/admin",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ]
}
